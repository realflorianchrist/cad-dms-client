{
  "name": "@workspace/client-ui",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:watch": "graphql-codegen --config codegen.ts --watch",
    "test:api-types": "tsc --noEmit -p tsconfig.api-tests.json"
  },
  "dependencies": {
    "@graphql-typed-document-node/core": "^3.2.0",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@tanstack/react-query": "^5.104.0",
    "@workspace/ui": "workspace:*",
    "graphql": "^17.0.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.4.3",
    "@graphql-codegen/client-preset": "^6.2.0",
    "@parcel/watcher": "^2.6.0",
    "@tailwindcss/vite": "^4",
    "@turbo/gen": "^2.10.12",
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4",
    "typescript": "^6.0.3"
  },
  "exports": {
    ".": "./src/index.ts",
    "./components/*": "./src/components/*.tsx",
    "./paths": "./src/paths.ts",
    "./api": "./src/api/index.ts",
    "./api/graphql": "./src/api/client/graphql.ts",
    "./api/generated": "./src/api/generated/graphql.ts"
  }
}
